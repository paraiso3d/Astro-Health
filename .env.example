# Copy to .env and fill in. Never commit .env.
# All values are in your Supabase project. See README for where to find each one.

# Project Settings > API: Project URL
SUPABASE_URL=

# Project Settings > API Keys: publishable key (or legacy "anon" key)
SUPABASE_PUBLISHABLE_KEY=

# Project Settings > API Keys: secret key (or legacy "service_role" key). Server only.
SUPABASE_SECRET_KEY=

