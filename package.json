{
  "name": "astrohealth",
  "version": "1.0.0",
  "description": "Crew health monitoring system for astronauts on long-duration space missions",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --disable-warning=ExperimentalWarning src/server.js",
    "build": "vite build",
    "start": "vite build && node --disable-warning=ExperimentalWarning src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\"",
    "check:supabase": "node scripts/check-supabase.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.2.1",
    "vite": "8.3.6"
  }
}
